# =========================================================
# DocuEase AI — Environment Configuration
# "Understand Any Document, in Your Language"
# HackSphere AI Hackathon Edition
# =========================================================

# --- Server & Network ---
PORT=5001
NODE_ENV=development

# --- Google Gemini Multimodal Vision AI ---
# Required for live OCR handwriting understanding, multimodal document reasoning, and structured output
# Supported models: gemini-2.5-flash (recommended), gemini-3.7-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Optical OCR & Handwriting Engine Mode ---
# Options: 'clinical_engine' (Tesseract OCR + heuristic stroke detection), 'gemini_multimodal'
OCR_MODE=clinical_engine

# --- Optional Cloud Services (Graceful Fallback Included) ---
# Optional: Google Cloud Vision API credentials for cloud handwriting extraction
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Google Cloud Translation API (Fallback: Gemini & verified multilingual dictionary)
TRANSLATION_API_KEY=

# Optional: Google Cloud Text-to-Speech API (Fallback: Web Speech API synthesis)
GOOGLE_TTS_API_KEY=

# --- Database & Retention Architecture ---
# SQLite is pre-configured and runs locally out-of-the-box (db/krishxtattva.sqlite)
DATABASE_URL=sqlite:./db/krishxtattva.sqlite

# --- Security & Ephemeral Document Processing ---
JWT_SECRET=super_secret_jwt_key_replace_in_production
DOCUMENT_RETENTION_HOURS=24
ENABLE_AUDIT_LOGGING=true
